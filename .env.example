# === Modo Produção Firebase (preencher ao criar projeto no Firebase Console) ===
# Nota: No Firebase App Hosting, FIREBASE_WEBAPP_CONFIG é injetado automaticamente em runtime.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Opcional: App Check reCAPTCHA Enterprise Site Key
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# === IA Gemini (Server-side em /api/ai/chat) ===
# Crie uma chave em Google AI Studio ou Vertex AI e adicione como Secret no App Hosting
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# === Emuladores locais (opcional: "true" para usar Firebase Local Emulator Suite) ===
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
