rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Cofre Documental do Titular: apenas PDF/JPG/PNG/WEBP (bloqueia SVG contra XSS), max 25MB
    match /vault/{userId}/{allPaths=**} {
      allow read: if request.auth != null
        && (request.auth.uid == userId
            || request.auth.token.role in ['advisor', 'legal_reviewer', 'compliance_officer', 'admin']);
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size > 0
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/jpeg|image/png|image/webp');
      // Documentos enviados não são apagados diretamente pelo client (imutabilidade/auditoria)
      allow delete: if false;
    }

    // Imagens públicas do catálogo de imóveis (somente admin escreve)
    match /properties/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
  }
}
